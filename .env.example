# -----------------------------------------------------------------
# CampusMate environment variables
# Copy this file to ".env" (in the project root) and fill in the
# real values. Never commit the real ".env" file to git.
# -----------------------------------------------------------------

# ---- AI layer (already used by the existing agents / router) ----
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Database (SQLite) ----
# SQLite stores the whole database as a single local file - no
# server or network setup needed. The file is created automatically
# the first time you run the backend.
SQLITE_DB_PATH=campusmate.db

# ---- JWT authentication (backend/app/auth) ----
# Any long random string works. You can generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
# Token validity, in minutes
JWT_EXPIRE_MINUTES=1440

# ---- CORS ----
# The URL where the React frontend runs (Vite default shown below)
FRONTEND_ORIGIN=http://localhost:5173
